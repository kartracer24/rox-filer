# EditorConfig - https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = tab
tab_width = 8

[*.{md,xml,ui,xsl}]
indent_style = space
indent_size = 2

# Vendored freedesktop.org mime resolver - uses 4-space indent upstream
[ROX-Filer/src/xdgmime*.{c,h}]
indent_style = space
indent_size = 4

# DocBook manual uses 1-space indent (vim: sw=1 sts=1)
[**/Docs/Manual*.xml]
indent_style = space
indent_size = 1

[*.po]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
